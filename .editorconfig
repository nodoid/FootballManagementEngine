root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.cs]
# This codebase keeps short object initializers compact, several properties
# to a line (see src/UkDatabase.cs). Don't split them one-per-line.
csharp_new_line_before_members_in_object_initializers = false
