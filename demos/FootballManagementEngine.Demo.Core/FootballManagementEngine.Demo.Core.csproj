<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>FootballManagementEngine.Demo</RootNamespace>
  </PropertyGroup>

  <!--
    The engine at the repository root is an Exe, and a self-contained mobile head cannot
    reference a non self-contained executable (NETSDK1150). This project compiles the same
    engine sources into a library so the MAUI and MonoGame heads can share them. Program.cs
    is excluded because it holds the console app's top-level entry point.
  -->
  <ItemGroup>
    <Compile Include="../../src/**/*.cs" Exclude="../../src/Program.cs" LinkBase="Engine" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

</Project>
